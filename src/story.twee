:: StoryTitle
The Fox and the Crow: A Day in Loop

:: StoryData
{
    "ifid": "7A4F23F7-9B8B-4E75-9E84-3A626B435833",
    "format": "SugarCube",
    "format-version": "2.30.0",
    "start": "Morning",
    "zoom": 1
}

:: StoryInit
<<set $loopCount = 0>>
<<set $learnedActions = {}>>
<<set $generatedTurn = null>>
<<set $gameSessionId = null>>
<<set $currentTurn = null>>
<<set $foxMemories = []>>
<<set $storyLog = []>>
<<set $pendingStoryAction = null>>

:: PassageHeader [nobr]
<header class="story-header">
    <p class="eyebrow">THE FOX AND THE CROW</p>
    <div class="story-header-actions">
        <<if State.passage is "New Tomorrow">>
            <p class="loop-counter">NEW TOMORROW</p>
        <<else>>
            <p class="loop-counter">DAY <<print $loopCount + 1>></p>
        <</if>>
        <button class="story-log-open" type="button">Story Log</button>
    </div>
</header>

<dialog class="story-log-dialog" aria-labelledby="story-log-title">
    <div class="story-log-shell">
        <header class="story-log-header">
            <div>
                <p class="story-log-eyebrow">THE JOURNEY SO FAR</p>
                <h2 id="story-log-title">Story Log</h2>
            </div>
            <button class="story-log-close" type="button" aria-label="Return to the story">Back to the story</button>
        </header>
        <nav class="story-log-days" aria-label="Visited days"></nav>
        <section class="story-log-content" aria-live="polite"></section>
        <footer class="story-log-footer">
            <div>
                <h3>Begin again</h3>
                <p>Erase this journey and return to the first morning.</p>
            </div>
            <button class="story-restart-open" type="button">Restart the story</button>
            <div class="story-restart-confirmation" hidden>
                <p><strong>Restart from Day 1?</strong> Your current story and journal will be erased.</p>
                <div class="story-restart-actions">
                    <button class="story-restart-cancel" type="button">Keep playing</button>
                    <button class="story-restart-confirm" type="button">Restart the story</button>
                </div>
            </div>
        </footer>
    </div>
</dialog>

:: StoryStylesheet [stylesheet]
@import url("https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;600;700&display=swap");

:root {
    color-scheme: dark;
    --ink: #f8f0dc;
    --muted: #c6b99f;
    --accent: #f1b24a;
    --accent-strong: #ffd07d;
    --panel: rgba(28, 25, 21, 0.88);
    --line: rgba(241, 178, 74, 0.28);
}

html {
    min-height: 100%;
    background: #151915;
}

body {
    min-height: 100vh;
    margin: 0;
    color: var(--ink);
    background:
        radial-gradient(circle at 50% 8%, rgba(214, 145, 48, 0.18), transparent 34rem),
        linear-gradient(180deg, #273128 0%, #151915 62%, #101210 100%);
    font-family: "Noto Serif", Georgia, serif;
}

body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: "";
    opacity: 0.26;
    background-image:
        linear-gradient(115deg, transparent 49%, rgba(255, 255, 255, 0.035) 50%, transparent 51%),
        linear-gradient(25deg, transparent 49%, rgba(255, 255, 255, 0.025) 50%, transparent 51%);
    background-size: 46px 46px, 62px 62px;
}

#ui-bar {
    display: none;
}

#story {
    margin-left: 0;
}

#passages {
    width: min(42rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 9vh 0 12vh;
}

.story-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
}

.story-header p {
    margin: 0;
}

.story-header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
}

.eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
}

.loop-counter {
    color: var(--muted);
    font-family: system-ui, sans-serif;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
}

.story-log-open,
.story-log-close,
.story-log-day,
.story-restart-open,
.story-restart-cancel,
.story-restart-confirm {
    border: 1px solid rgba(241, 178, 74, 0.48);
    border-radius: 2px;
    color: var(--accent-strong);
    background: rgba(241, 178, 74, 0.07);
    font: 600 0.78rem/1.2 system-ui, sans-serif;
    letter-spacing: 0.04em;
    cursor: pointer;
}

.story-log-open {
    padding: 0.55rem 0.7rem;
    text-transform: uppercase;
}

.story-log-open:hover,
.story-log-open:focus-visible,
.story-log-close:hover,
.story-log-close:focus-visible,
.story-log-day:hover,
.story-log-day:focus-visible,
.story-log-day[aria-pressed="true"],
.story-restart-cancel:hover,
.story-restart-cancel:focus-visible {
    border-color: var(--accent-strong);
    color: #17130d;
    background: var(--accent-strong);
}

.story-log-dialog {
    box-sizing: border-box;
    width: min(58rem, calc(100% - 2rem));
    max-width: none;
    max-height: min(90vh, 54rem);
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(241, 178, 74, 0.36);
    border-radius: 3px;
    color: var(--ink);
    background: #171914;
    box-shadow: 0 2rem 7rem rgba(0, 0, 0, 0.72);
}

.story-log-dialog::backdrop {
    background: rgba(5, 8, 6, 0.82);
    backdrop-filter: blur(3px);
}

.story-log-shell {
    display: flex;
    flex-direction: column;
    max-height: min(90vh, 54rem);
}

.story-log-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
